# Copy this file to `.env` and fill in real values — `.env` is gitignored,
# `.env.example` is committed as documentation and has no real secrets.

# Supabase → Project Settings → Database → Connection string → "Transaction"
# pooler mode (port 6543). This is what Payload's Postgres adapter actually
# connects to — it's the piece that makes "edit in the CMS → database
# updates → page updates" work.
DATABASE_URI=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Any long random string — used to sign Payload's auth tokens. Generate one
# with, e.g.: openssl rand -base64 32
PAYLOAD_SECRET=

# Used for absolute URLs (metadata, sitemaps, etc.) — update for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API → Project URL. Used only by the Media
# collection's storage adapter (file uploads go to Supabase Storage instead
# of local disk) — not needed for the database connection above.
SUPABASE_URL=

# Supabase → Project Settings → API → service_role key (server-only — never
# expose this to the browser). Also used only by the Media storage adapter.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Storage → the bucket name to upload media into. Create this
# bucket in the Supabase dashboard first (Storage → New bucket, "Public"
# so images can be served directly). Defaults to "media" if unset.
SUPABASE_STORAGE_BUCKET=media

# Supabase → Project Settings → General → Region (as an S3 region code,
# e.g. a project in "South Asia (Mumbai)" is ap-south-1). Defaults to
# ap-south-1 if unset — change if your project is hosted elsewhere.
SUPABASE_STORAGE_REGION=ap-south-1
